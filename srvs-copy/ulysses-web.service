[Unit]
Description=Ulysses Lab Web Frontend
After=network.target

[Service]
User=michael
Group=michael
# ИСПРАВЛЕНО: Указана новая очищенная директория фронтенда
WorkingDirectory=/home/michael/Ulysses/web

# Пробрасываем окружение NVM, чтобы systemd видел node и pnpm пользователя michael
Environment="PATH=/home/michael/.nvm/versions/node/v20.20.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment=NODE_ENV=development

# Запуск dev-сервера через pnpm из NVM окружения
ExecStart=/home/michael/.nvm/versions/node/v20.20.2/bin/pnpm run dev --host

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

