[Unit]
Description=Ulysses VPN Backend Service
After=network.target postgresql.service

[Service]
Type=simple
User=michael
WorkingDirectory=/home/michael/Ulysses
Environment="PYTHONPATH=backend:."
ExecStart=/home/michael/Ulysses/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target

