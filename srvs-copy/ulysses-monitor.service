[Unit]
Description=Ulysses Shield Monitor Daemon
After=network.target postgresql.service

[Service]
Type=simple
User=michael
WorkingDirectory=/home/michael/Ulysses
Environment=PYTHONPATH=/home/michael/Ulysses/backend
ExecStart=/home/michael/Ulysses/.venv/bin/python -m cli monitor run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
