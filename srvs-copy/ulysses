# 1. ПОЧТОВЫЙ ПОДДОМЕН (MAILCOW)
server {
    server_name mail.ulysses.best;

    location / {
	#proxy_pass https://127.0.0.1:8443;
	proxy_pass http://127.0.0.1:8084;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

	# ВАЖНО: Передаем информацию о пользователе и сессии
        proxy_set_header X-Forwarded-User $remote_user;
	proxy_set_header Connection "";

        # ДОБАВЛЯЕМ ЭТИ СТРОКИ ДЛЯ СТАБИЛЬНОЙ РАБОТЫ ВЕБ-ПОЧТЫ (SOGo):
        proxy_buffer_size          128k;
        proxy_buffers              64 512k;
        proxy_busy_buffers_size    512k;

        proxy_ssl_session_reuse off;
        proxy_ssl_server_name on;
        client_max_body_size 0;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/ulysses.best/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ulysses.best/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    #ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

# 2. ОСНОВНОЙ САЙТ (VITE ФРОНТЕНД)
server {
    server_name ulysses.best;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Поддержка WebSockets для Vite
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

     # Проброс запросов API в FastAPI Бэкенд
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Проброс замаскированных Sing-box подписок в FastAPI Бэкенд
    location /subscription/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    # Вставка для Telegram Webhook
    location /tg-webhook {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Вставка для внешних уведомлений (API сайта)
    location /notify {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    #listen 443 ssl; # managed by Certbot
    #listen [::]:443 ssl ipv6only=on; # managed by Certbot
    #ssl_certificate /etc/letsencrypt/live/ulysses.best/fullchain.pem; # managed by Certbot
    #ssl_certificate_key /etc/letsencrypt/live/ulysses.best/privkey.pem; # managed by Certbot
    #include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    #ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/ulysses.best/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ulysses.best/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

# 3-4. РЕДИРЕКТЫ С HTTP (80) НА HTTPS (443) ДЛЯ ВСЕХ ДОМЕНОВ
server {
    if ($host = mail.ulysses.best) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = ulysses.best) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name ulysses.best www.ulysses.best mail.ulysses.best;

    # Служебная папка для проверок Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Все остальные запросы принудительно переводим на HTTPS
    location / {
        return 301 https://$host$request_uri;
    }




}


